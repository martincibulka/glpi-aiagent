# ==============================================================
# GLPI Ticket AI Agent - Konfigurácia prostredia
# ==============================================================

# 1. Pripojenie na GLPI REST API
# GLPI REST API URL (typicky: https://vasa-domena.sk/glpi/apirest.php alebo https://glpi.firma.sk/apirest.php)
GLPI_URL="https://glpi.firma.sk/apirest.php"

# App-Token: Vygenerovaný v GLPI: Nastavenia -> Všeobecné -> API -> Pridať API klienta (povoliť aplikáciu)
GLPI_APP_TOKEN="vas_glpi_app_token"

# User-Token: Vygenerovaný v profile používateľa/technika (Môj profil -> API tokeny -> Vytvoriť používateľský token)
GLPI_USER_TOKEN="vas_glpi_user_token"

# Ignorovať neplatné SSL certifikáty (užitočné pre interné / self-signed certifikáty v testovacom prostredí)
GLPI_ALLOW_SELF_SIGNED="false"

# 2. AI Model & Poskytovateľ (gemini alebo openai)
AI_PROVIDER="gemini"

# Google Gemini API kľúč (Získate zadarmo na https://aistudio.google.com/)
GEMINI_API_KEY="vas_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# OpenAI API kľúč (ak zvolíte AI_PROVIDER="openai")
OPENAI_API_KEY="vas_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# 3. Parametre vyhľadávania a asistenta
# Prah podobnosti (0.0 až 1.0) - čím vyššie, tým prísnejšie zhody s minulosťou
SIMILARITY_THRESHOLD="0.60"

# Koľko najviac podobných historických tiketov použiť ako kontext pre LLM
TOP_K_MATCHES="3"

# Interval kontroly nových tiketov v sekundách (pre režim watch)
POLL_INTERVAL_SECONDS="60"

# Označenie privátnej poznámky (v GLPI: 1 = privátna poznámka iba pre technikov, 0 = verejné)
NOTE_IS_PRIVATE="1"

# Cesta k priečinku s lokálnou vektorovou databázou
DATA_DIR="./data"
